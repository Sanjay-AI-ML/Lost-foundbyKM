# Obtain a tenant key from CyberAccess -> API access. Never put this in frontend code.
CYBERACCESS_API_KEY=sk_replace_with_your_tenant_key
CYBERACCESS_API_URL=http://127.0.0.1:8017
CYBERACCESS_ENABLED=true
CYBERACCESS_FAIL_OPEN=false
CYBERACCESS_TIMEOUT=2.0

# In-app security alerts and safe server logs. Repeated denials are grouped per user.
CYBERACCESS_NOTIFICATIONS_ENABLED=true
CYBERACCESS_NOTIFICATION_COOLDOWN_SECONDS=60
CYBERACCESS_LOG_ALLOWED=false
# Optional rotating log file; leave empty to use server console logs only.
CYBERACCESS_SECURITY_LOG_FILE=

# Optional local demonstration. Never enable on a public deployment.
DJANGO_SECRET_KEY=replace_with_your_own_random_django_secret
CYBERACCESS_DEMO_ENABLED=false
DJANGO_DEBUG=true
CYBERACCESS_CONSOLE_URL=http://127.0.0.1:5177
# DJANGO_DATABASE_PATH=path/to/disposable-demo.sqlite3
